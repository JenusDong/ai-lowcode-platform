{"version": "1.0.0", "name": "lowcode-packages-standard", "description": "低代码组件库/插件开发标准规范", "standard": {"codeStyle": {"indent": 2, "quotes": "single", "semi": true, "trailingComma": "es5", "printWidth": 100, "endOfLine": "lf"}, "typescript": {"target": "ES2018", "module": "ESNext", "strict": true, "jsx": "react-jsx"}, "directoryStructure": {"components": "src/components/", "meta": "src/meta/", "setters": "src/setters/", "types": "src/types/", "shims": "src/shims/", "adapters": "src/adapters/"}, "requiredFiles": ["package.json", "tsconfig.json", ".prettierrc.json", ".eslintrc.json", ".gitignore", "README.md", "CONTRIBUTING.md"], "scripts": {"dev": "node scripts/build.js --watch", "build": "node scripts/build.js", "lint": "eslint 'src/**/*.{ts,tsx}'", "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix", "format": "prettier --write 'src/**/*.{ts,tsx,json}'", "typecheck": "tsc --noEmit"}}, "commitMessageFormat": "<type>(<scope>): <subject>", "versioning": "semver"}, "packages": {"mall-components": {"path": "packages/mall-components", "type": "component-library", "framework": "antd", "entry": "src/index.ts", "metaEntry": "src/meta.ts", "globalName": "MallComponents", "globalMetaName": "MallComponentsMeta"}, "plugin-echarts": {"path": "packages/plugin-echarts", "type": "plugin", "framework": "echarts", "entry": "src/plugin.ts", "metaEntry": "src/meta.ts", "globalName": "PluginEcharts", "globalMetaName": "PluginEchartsMeta"}}}