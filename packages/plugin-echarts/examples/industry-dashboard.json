    {
      "componentName": "EChartsMap",
      "props": {
        "style": {
          "width": "100%",
          "height": "600px",
          "borderRadius": "8px",
          "overflow": "hidden"
        },
        "option": {
          "backgroundColor": "#0a1a3a",
