            "top": 20,
            "textStyle": {
              "color": "#ffffff",
              "fontSize": 20,
              "fontWeight": "bold"
            }
          },
          "tooltip": {
            "trigger": "item",
            "formatter": "{b}<br/>销售额: ¥{c}"
          },
          "visualMap": {
            "min": 0,
            "max": 2000,
            "left": "left",
            "bottom": 20,
